APP_NAME=DeltaLedger AI
APP_VERSION=0.1.0
APP_PROFILE=local-cloud
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
READINESS_DEPENDENCY_CHECKS_ENABLED=false
AUTH_ENABLED=false
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_SECONDS=3600
AUTH_LOGIN_USERNAME=demo
AUTH_LOGIN_PASSWORD=
AUTH_LOGIN_ROLE=admin

POSTGRES_USER=deltaledger
POSTGRES_PASSWORD=
POSTGRES_DB=deltaledger
POSTGRES_TEST_DB=deltaledger_test

DATABASE_URL=postgresql+asyncpg://deltaledger@localhost:5433/deltaledger
ALEMBIC_DATABASE_URL=postgresql+psycopg://deltaledger@localhost:5433/deltaledger
TEST_DATABASE_URL=postgresql+asyncpg://deltaledger@localhost:5433/deltaledger_test
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=300
DOCKER_DATABASE_URL=
DOCKER_ALEMBIC_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
# Dramatiq per-actor time limit (seconds) for ordinary short/single-stage
# tasks (filing processing, single comparison, claim extraction/verification,
# contradiction analysis). Keep this small so a genuinely hung short task is
# killed quickly.
WORKER_DEFAULT_TIME_LIMIT_SECONDS=1800
# The full analysis workflow actor (run_analysis_workflow_task /
# resume_analysis_workflow_task) runs BGE embedding, up to hundreds of
# 15s-paced Gemini classification calls, claim extraction/verification, and
# contradiction analysis in ONE actor invocation - a real run has been
# observed needing ~48 minutes for disclosure classification alone. 3 hours
# gives comfortable headroom for a full cold run across every stage while
# still bounding a truly hung/stuck actor (this is a single-threaded worker,
# so a hang here blocks everything else). Raise only if a real run needs
# more; do not set this on every actor (see WORKER_DEFAULT_TIME_LIMIT_SECONDS
# above) - short jobs should keep failing fast.
ANALYSIS_WORKFLOW_TIME_LIMIT_SECONDS=10800

OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_LOCAL_ROOT=./data/object-storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_BUCKET_FILINGS=filings
MINIO_BUCKET_REPORTS=reports

SEC_USER_AGENT=DeltaLedgerAI/0.1 your-email@example.com
SEC_BASE_URL=https://www.sec.gov
SEC_DATA_URL=https://data.sec.gov
SEC_REQUEST_TIMEOUT_SECONDS=20
SEC_MAX_ATTEMPTS=3
SEC_MIN_WAIT_SECONDS=1
SEC_MAX_WAIT_SECONDS=8
SEC_REQUESTS_PER_SECOND=5

PARSER_VERSION=sec-html-parser-v0
TABLE_EXTRACTION_VERSION=sec-table-extractor-v0
CHUNKER_VERSION=section-aware-chunker-v0
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=60

EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_BATCH_DELAY_SECONDS=0.75
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_INSTRUCTION=
EMBEDDING_TIMEOUT_SECONDS=60
HF_TOKEN=
HF_INFERENCE_BASE_URL=https://api-inference.huggingface.co
ALLOW_FAKE_MODELS_IN_PRODUCTION=false
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_TIMEOUT_SECONDS=60
AI_PROVIDER_MAX_RETRIES=5
AI_PROVIDER_RETRY_BASE_DELAY_SECONDS=1
AI_PROVIDER_RETRY_MAX_DELAY_SECONDS=60
AI_PROVIDER_RETRY_JITTER_SECONDS=0.5
# Minimum gap between chat-completion calls (change/claim/contradiction
# classifiers). 0 disables pacing (the default) - if you intend to rate-limit
# against a free-tier quota, this MUST be set explicitly; it does not infer a
# value from any observed quota error.
AI_PROVIDER_CHAT_DELAY_SECONDS=0
# Extra attempts to ask the model to correct its own structured-output
# response when it fails schema validation, before giving up on that one
# item. 0 disables repair (fails immediately, as before this existed).
AI_PROVIDER_STRUCTURED_OUTPUT_REPAIR_ATTEMPTS=1
# Resumable batch processing for disclosure classification and financial-claim
# extraction. Work is split into durable batches ("parts"); a retry resumes at
# the first incomplete batch and never redoes completed ones.
#   AI_BATCH_MAX_ITEMS: hard cap on items per batch (1 = one item per batch).
#   AI_BATCH_INPUT_TOKEN_BUDGET: estimated input tokens allowed per provider
#     request. Set this from your model's real limits; nothing is assumed.
#   AI_BATCH_TOKEN_SAFETY_MARGIN: fraction of the budget held back because the
#     token count is a character-based estimate (0.25 = plan to 75% of budget).
#   AI_BATCH_MULTI_ITEM_REQUESTS: true sends one multi-item request per batch;
#     false keeps durable batches but sends one request per item.
AI_BATCH_MAX_ITEMS=8
AI_BATCH_INPUT_TOKEN_BUDGET=12000
AI_BATCH_TOKEN_SAFETY_MARGIN=0.25
AI_BATCH_MULTI_ITEM_REQUESTS=true
AI_PROVIDER_INPUT_TOKEN_COST_USD_PER_MILLION=
AI_PROVIDER_OUTPUT_TOKEN_COST_USD_PER_MILLION=

RERANKER_ENABLED=false
RERANKER_PROVIDER=fake
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_BATCH_SIZE=16
RERANKER_CANDIDATE_LIMIT=40
RERANKER_TIMEOUT_SECONDS=60

CHANGE_CLASSIFIER_PROVIDER=fake
CHANGE_CLASSIFIER_MODEL=deterministic-disclosure-change-v1
CLAIM_EXTRACTOR_PROVIDER=fake
CLAIM_EXTRACTOR_MODEL=deterministic-financial-claim-extractor-v1
WORKFLOW_CHECKPOINT_PROVIDER=memory

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
